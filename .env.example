# App configuration.
# Copy to .env -- config/settings.py loads it automatically via python-dotenv,
# so no `export` step is needed. Real environment variables always take
# precedence over this file, so Vercel's project env vars win in production.
# .env is gitignored -- credentials never get committed.
#
# Write `KEY=value` with NO spaces around `=`. A POSIX shell parses
# `KEY = value` as a command named KEY, so spaces break `set -a; . ./.env`.
# Quote any value containing `&`, `?` or spaces (Neon URLs contain `&`).

# --- Deployment (Vercel) ----------------------------------------------------
# Unset locally -- defaults below match local development out of the box.
# These four must ALSO be set in the Vercel project env vars; .env is local
# only and is never deployed.
#SECRET_KEY=                       # required in production; any long random string
#DEBUG=False                       # defaults to False on Vercel, True locally; only set this to turn debug ON deliberately
#ALLOWED_HOSTS=otro-dominio.com    # comma-separated; VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL and this project's own domains (settings.CUSTOM_DOMAINS) are trusted automatically -- only extra domains go here
# The ONE public origin for the image links handed to WhatsApp (quick replies
# with a photo). Meta downloads them from its own servers, with no session:
# every alias of the project except the production domain is behind Vercel
# SSO, so a link to any of those fails the send a few seconds after it was
# accepted. Defaults to https://$VERCEL_PROJECT_PRODUCTION_URL; set it
# explicitly if that variable is not exposed to the project. `manage.py check`
# warns when it is empty (core.W002) or points somewhere Meta can't reach
# (core.W003), and every Vercel build log prints the value it resolved to.
#PUBLIC_BASE_URL=https://mvp-crm-lake.vercel.app

# Con DEBUG=False el proyecto ya sirve cookies de sesión y CSRF solo por HTTPS
# y redirige el tráfico HTTP (config/settings.py). No hace falta configurarlo.
#
# HSTS es la excepción, y es opt-in a propósito: le dice al navegador que se
# niegue a hablar HTTP con este dominio durante max-age segundos, y eso NO se
# puede deshacer dentro de esa ventana. Actívalo solo sobre un dominio que ya
# esté del todo en HTTPS, y empieza con un max-age corto (3600) antes de subir
# a un año (31536000).
#SECURE_HSTS_SECONDS=0
# Estas dos solo aplican con HSTS encendido, y amplían su alcance: la primera
# cubre todos los subdominios (incluidos los que aún no estén en HTTPS), y la
# segunda pide que la regla venga de fábrica en el navegador, mucho más difícil
# de revertir que esperar a que expire el max-age.
#SECURE_HSTS_INCLUDE_SUBDOMAINS=False
#SECURE_HSTS_PRELOAD=False

# Seed for the first master users. Every login lives in the database and is
# managed from CRM > Equipo > Usuarios (core/agents.py); this list is imported
# into it ONCE per username so a fresh deployment has a master to start with.
# After that the database wins: a password changed in the app sticks, a
# deactivated user stays out, and the variable can be removed entirely.
# Comma-separated `username:hash:Nombre` entries; the display name is
# optional. Passwords can't contain ':' or ',' -- those are the separators.
# The middle field is a password HASH -- `manage.py hashear_clave <usuario>`
# prints a pasteable entry. A raw password there still works (a redeploy must
# never lock the team out), but `manage.py check` names every agent still
# configured that way (core.W001): anyone who can read this environment can
# log in as them. With no seed at all, `manage.py crear_maestro <usuario>`
# creates the first master directly in the database.
#APP_AGENTS=Admin:pbkdf2_sha256$...:Admin,Samuel:pbkdf2_sha256$...:Samuel

# Legacy single pair, still honored when APP_AGENTS is unset (it becomes the
# one agent). Prefer APP_AGENTS above.
#APP_LOGIN_USERNAME=
#APP_LOGIN_PASSWORD=

# Required in production -- SQLite has no persistent disk on Vercel. Parsed by
# dj-database-url, which forwards the query string into the connection's
# OPTIONS, so Neon's ?sslmode=require&channel_binding=require is honored
# rather than silently dropped. Get the value for this project with:
#   neon connection-string --project-id crimson-tooth-69514377
#DATABASE_URL="postgresql://user:password@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Messaging configuration.

# Which provider backs sending and webhooks. REQUIRED -- the app refuses to
# start without it -- and `meta` is the only value it has: the old `fake`
# simulator is gone, and a leftover MESSAGING_PROVIDER=fake stops the app at
# startup. Browsing the app locally needs no Meta credentials; sending does,
# and those messages reach real phones (Meta's test number works).
MESSAGING_PROVIDER=meta


# --- Precio de las plantillas ----------------------------------------------
# Escribir a un cliente fuera de la ventana de 24 horas (todo cliente nuevo)
# se hace con una plantilla, y WhatsApp cobra cada envío según la categoría
# de la plantilla y el país del destinatario. El CRM guarda lo que costó
# cada mensaje y corrige la cifra con lo que Meta reporta después.
#
# El CRM ya trae la tarifa publicada por Meta (messaging/meta_rates.py: las
# tablas que Meta descarga desde developers.facebook.com/docs/whatsapp/pricing,
# la vigente y la ya anunciada). No hace falta configurar nada para cotizar.
#
# MESSAGING_TEMPLATE_RATES solo hace falta si TU cuenta paga otras tarifas
# (contrato con un BSP, precio promocional) o factura en otra moneda. Es un
# JSON con los nombres de mercado de Meta -> categoría -> precio, y se
# superpone fila por fila: lo que no nombres queda con la tarifa de Meta.
#MESSAGING_TEMPLATE_RATES={"Colombia": {"marketing": "0.0125"}, "Rest of Latin America": {"marketing": "0.0740"}}
#MESSAGING_CURRENCY=USD

# Optional monthly ceiling on template spend, in the pricing currency. Empty
# means no limit. send_template refuses a send that would cross it, so this is
# a real guard rather than a dashboard number.
#MESSAGING_MONTHLY_BUDGET=50

# Desde el 1 de octubre de 2026 Meta cobra los mensajes de servicio (todo lo
# que sale con la ventana de 24 horas abierta), pero regala los primeros de
# cada mes por número. Meta publica 1000, y es lo que trae el CRM por defecto.
# Ponlo en 0 si tu cuenta no tiene ese cupo: es la parte peor corroborada del
# cambio de octubre, por eso es variable y no una constante.
#MESSAGING_SERVICE_FREE_ALLOWANCE=1000

# --- meta (WhatsApp Cloud API) ---------------------------------------------
# From developers.facebook.com > your app > WhatsApp. META_APP_SECRET signs
# webhooks (X-Hub-Signature-256); META_VERIFY_TOKEN is the value you type
# into the webhook subscribe form (any string, must match).
#META_ACCESS_TOKEN=
#META_PHONE_NUMBER_ID=
#META_APP_SECRET=
#META_VERIFY_TOKEN=
# WhatsApp Business Account id (Business settings > Accounts > WhatsApp
# accounts) and the app id (developers.facebook.com > your app > App ID).
# Both are needed to submit plantillas to Meta for approval and to read the
# approval verdicts back; without them plantillas stay local and Pendiente.
#META_WABA_ID=
#META_APP_ID=
